{
  "name": "avclient-livekit",
  "description": "LiveKit A/V module for FoundryVTT",
  "packageManager": "pnpm@10.33.3",
  "type": "module",
  "private": true,
  "repository": "https://github.com/kalelkenobi/fvtt-module-avclient-livekit",
  "author": "kalelkenobi",
  "license": "Hippocratic-2.1",
  "scripts": {
    "dev": "vite",
    "serve:prod": "vite --mode production",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "watch": "vite build --mode development --watch",
    "watch:prod": "vite build --watch",
    "clean": "rm -rf dist",
    "clean:deep": "rm -rf dist node_modules"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "debug": "^4.4.3",
    "jose": "^6.2.3",
    "livekit-client": "^2.18.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pixi/assets": "github:foundry-vtt-types/pixi-assets#main",
    "@pixi/compressed-textures": "github:foundry-vtt-types/pixi-compressed-textures#main",
    "@pixi/core": "github:foundry-vtt-types/pixi-core#main",
    "@types/debug": "^4.1.13",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.3.0",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#main",
    "prettier": "3.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.59.2",
    "vite": "^8.0.10",
    "vite-plugin-checker": "0.13.0",
    "vite-plugin-eslint2": "^5.1.0",
    "vite-plugin-static-copy": "^4.1.0"
  }
}
